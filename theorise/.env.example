# ── Network selection ────────────────────────────────────────────────
# 'mainnet' (default) keeps the live HyperEVM factory at chain 999;
# 'testnet' swaps in HyperEVM testnet (chain 998) + HL testnet API.
NEXT_PUBLIC_NETWORK=mainnet

# ── VaultFactory addresses (per network) ─────────────────────────────
# Mainnet factory deployed at 0x9741D9f39FE4a45A07B2B212E186930b399F0683.
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS_MAINNET=0x9741D9f39FE4a45A07B2B212E186930b399F0683
# Set once the new (creator-vault / ERC-4626) factory is deployed to testnet.
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
# Legacy single-network var — still read as a fallback for mainnet.
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=

# Block at which the testnet factory was deployed. Used to bound getLogs
# scans in the My Vaults modal. Leave unset (=0) until deployed.
NEXT_PUBLIC_VAULT_FACTORY_DEPLOY_BLOCK_TESTNET=

# ── USDC on HyperEVM testnet ─────────────────────────────────────────
# There is no canonical USDC on HyperEVM testnet. Either deploy a mock
# ERC-20 ourselves or point at a community-deployed testnet USDC.
NEXT_PUBLIC_USDC_ADDRESS_TESTNET=0x0000000000000000000000000000000000000000
