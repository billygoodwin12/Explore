{
  "name": "polymarket-amm-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup:approvals": "tsx src/cli/setup-approvals.ts",
    "derive:apikey": "tsx src/cli/derive-apikey.ts",
    "paper": "DRY_RUN=true tsx src/cli/live.ts",
    "live": "tsx src/cli/live.ts",
    "reconcile": "tsx src/cli/reconcile.ts",
    "redeem": "tsx src/cli/redeem.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "dashboard:dev": "vite dev --config dashboard/vite.config.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.1",
    "@polymarket/clob-client": "^4.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.0",
    "ethers": "^5.7.2",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "p-retry": "^6.2.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "recharts": "^2.15.0",
    "uuid": "^11.0.5",
    "viem": "^2.23.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
