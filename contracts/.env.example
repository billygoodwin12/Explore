# Copy to .env (which is gitignored) and fill in.
# source the file before running cast/forge commands:
#   export $(grep -v '^#' .env | xargs)

# HyperEVM testnet — what Phase 1 deploys against.
HYPEREVM_TESTNET_RPC=https://rpc.hyperliquid-testnet.xyz/evm

# Native Circle USDC on HyperEVM testnet (verified Phase 0).
# Mainnet is 0xb88339CB7199b77E23DB6E890353E22632Ba630f.
USDC_ADDRESS=0x2B3370eE501B4a559b57D449569354196457D8Ab

# Circle's CoreDepositWallet — canonical USDC bridge (EVM → Core).
# Direct ERC-20 transfers to the system address are blacklisted by Circle,
# so USDC must go through this proxy. Address is per-network:
#   testnet: 0x0b80659a4076E9E93c7dbe0F10675A16A3e5C206
#   mainnet: 0x6b9e773128f453F5C2c60935ee2De2cBC5390a24
CORE_DEPOSIT_WALLET=0x0b80659a4076E9E93c7dbe0F10675A16A3e5C206

# Deployer key. Treat as compromised if pasted in chat — rotate immediately.
PRIVATE_KEY=

# Optional overrides for the deploy script.
# CREATOR_ADDRESS=
# ADMIN_ADDRESS=                # defaults to deployer; set to multisig for mainnet
# VAULT_NAME=Theorise Test Vault
# VAULT_SYMBOL=tVAULT
